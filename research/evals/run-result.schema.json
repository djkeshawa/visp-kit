{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["taskId", "condition", "modelId", "seed", "failToPassPassed", "passToPassPassed", "scopeViolation", "requirementsCovered", "humanCorrection", "inputTokens", "outputTokens", "wallTimeMs"],
  "properties": {
    "taskId": { "type": "string" },
    "condition": { "type": "string" },
    "modelId": { "type": "string" },
    "seed": { "type": "integer" },
    "failToPassPassed": { "type": "boolean" },
    "passToPassPassed": { "type": "boolean" },
    "scopeViolation": { "type": "boolean" },
    "requirementsCovered": { "type": "boolean" },
    "humanCorrection": { "type": "boolean" },
    "inputTokens": { "type": "integer", "minimum": 0 },
    "outputTokens": { "type": "integer", "minimum": 0 },
    "monetaryCost": { "type": "number", "minimum": 0 },
    "wallTimeMs": { "type": "integer", "minimum": 0 },
    "toolCalls": { "type": "integer", "minimum": 0 },
    "clarificationTurns": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
