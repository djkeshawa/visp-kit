{
  "name": "visp-kit",
  "version": "0.1.1",
  "description": "Strict, token-efficient agent harness for gated AI-assisted implementation, scoped context, and evidence workflows.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djkeshawa/visp-kit.git"
  },
  "bugs": {
    "url": "https://github.com/djkeshawa/visp-kit/issues"
  },
  "homepage": "https://github.com/djkeshawa/visp-kit#readme",
  "keywords": [
    "ai",
    "codex",
    "spec-driven",
    "context-engineering",
    "token-efficient",
    "agent-native",
    "policy-as-code",
    "gates",
    "cli",
    "developer-tools"
  ],
  "bin": {
    "visp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schemas",
    "scripts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "schema:generate": "node scripts/generate-workflow-action-schemas.mjs",
    "schema:check": "node scripts/generate-workflow-action-schemas.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "install:global": "pnpm build && npm install -g .",
    "prepack": "pnpm schema:check && pnpm build"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
